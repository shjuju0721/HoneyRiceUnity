--- !u!114 &680549801
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 680549800}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbc72f9e3127c4947898deaea0619e0e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dimmer: {fileID: 1648396944}
  previewPanel: {fileID: 1552353444}
  titleText: {fileID: 169392425}
  descText: {fileID: 883797681}
  previewImage: {fileID: 1479201965}
  stages:
  - title: "1. \uB2EC \uD1A0\uB07C "
    description: "\uB2EC\uBE5B\uC744 \uB530\uB77C \uACC4\uB2E8\uC774 \uB193\uC600\uC5B4\uC694.\n\uC785\uC744
      \uD06C\uAC8C \uBC8C\uB9B4 \uB54C\uB9C8\uB2E4 \uD55C \uCE78\uC529!\n\uB2EC\uAE4C\uC9C0
      \uD568\uAED8 \uC62C\uB77C\uAC00 \uBCFC\uAE4C\uC694?"
    previewImage: {fileID: -8458591911652529014, guid: fee8ae03287479d419eb2373b2c00cfe, type: 3}
    sceneName: Stage01_Face
  - title: "2. \uC601\uCC28\uC601\uCC28 \uC904\uB2E4\uB9AC"
    description: "\uC904\uB2E4\uB9AC\uAE30\uAC00 \uC2DC\uC791\uB410\uC5B4\uC694!\n\uC785\uC220\uC744
      \uAFB9 \uB2E4\uBB3C\uACE0 \uD798\uAECF \uB2F9\uACA8\uC8FC\uC138\uC694.\n\uC601\uCC28,
      \uC601\uCC28!"
    previewImage: {fileID: 21300000, guid: 46f30ebd2dacba944a295292052a6609, type: 3}
    sceneName: Stage02_Rope
  - title: "3. \uBF40\uBF40 \uD558\uD2B8 \uCC44\uC6B0\uAE30"
    description: "\uB9C8\uC74C\uC744 \uB2F4\uC544 \uD558\uD2B8\uB97C \uBCF4\uB0B4\uC694.\n\uC785\uC220\uC744
      \uB3D9\uADF8\uB797\uAC8C \uC624\uBBC0\uB9AC\uBA74\n\uD558\uD2B8 \uD48D\uC120\uC774
      \uB450\uB465\uC2E4 \uB0A0\uC544\uAC11\uB2C8\uB2E4."
    previewImage: {fileID: 21300000, guid: a0c61d3605dd0eb45aacbfc2a88f0d78, type: 3}
    sceneName: Stage03_Heart
  - title: " 4. \uD3AD\uADC4 \uC2AC\uB77C\uC774\uB529 "
    description: "\uC544\uAE30 \uD3AD\uADC4\uC774 \uC9D1\uC5D0 \uAC00\uB294 \uAE38\uC774\uC5D0\uC694.\n\uBCFC\uC744
      \uBE75\uBE75\uD558\uAC8C \uBD80\uD480\uB9AC\uBA74\n\uC5BC\uC74C \uC704\uB97C
      \uC329\u2015 \uBBF8\uB044\uB7EC\uC838 \uAC11\uB2C8\uB2E4."
    previewImage: {fileID: 21300000, guid: da394b4d57ff17f40b1dd9d4ad01ead5, type: 3}
    sceneName: Stage04_Penguin
  - title: "5. \uBBF8\uC18C \uC0AC\uC9C4"
    description: "\uC624\uB298\uC740 \uC0AC\uC9C4 \uCC0D\uB294 \uB0A0!\n\uD65C\uC9DD
      \uC6C3\uC73C\uBA74 \uCC30\uCE75\u2015\n\uC608\uC05C \uC0AC\uC9C4\uC774 \uD55C
      \uC7A5\uC529 \uAC78\uB824\uC694."
    previewImage: {fileID: 21300000, guid: 21ee08771a9a15c4cb0d58b8a3a55c9e, type: 3}
    sceneName: Stage05_Smile
  - title: "6. \uAC1C\uAD6C\uB9AC \uAC8C"
    description: "\uBC30\uACE0\uD508 \uAC1C\uAD6C\uB9AC\uAC00 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC5B4\uC694.\n\uD600\uB97C \uC3D9 \uB0B4\uBC00\uC5B4\n\uD30C\uB9AC\uB97C
      \uC7A1\uC544\uC8FC\uC138\uC694!"
    previewImage: {fileID: 21300000, guid: 2c13e8b60551c3c449bf18c52d54dca5, type: 3}
    sceneName: Stage06_Frog
  - title: 7. Waiting
    description: "\uC900\uBE44\uC911\uC774\uC5D0\uC694 "
    previewImage: {fileID: 0}
    sceneName: 
